# Public address served by the reverse proxy or load balancer.
APP_URL=https://upnext.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Do not reuse the development credentials. URL-encode reserved characters in
# POSTGRES_PASSWORD when composing DATABASE_URL_DOCKER.
POSTGRES_USER=upnext
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=upnext
DATABASE_URL_DOCKER=postgres://upnext:replace-with-a-long-random-password@postgres:5432/upnext

# The app is intended to sit behind a TLS reverse proxy. Keep this loopback-only
# binding when the proxy runs on the same host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Set these to the credentials supplied by the transactional-email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=UpNext <bonjour@example.com>
SMTP_USER=
SMTP_PASSWORD=
