{
  "name": "@upnext/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:demo": "tsx src/db/demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@orpc/server": "1.15.2",
    "@upnext/contracts": "workspace:*",
    "better-auth": "1.7.5",
    "dotenv": "18.0.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
